{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stockman-private-market",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "triggers": {
    "crons": [
      "27 11 * * 1-5",
      "37 23 * * 0-4"
    ]
  },
  "vars": {
    "STOCKMAN_SYMBOLS": "[]"
  }
}
